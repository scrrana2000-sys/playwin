{
  "rules": {
    "ludo_rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "status": {
          ".validate": "newData.val() == 'WAITING' || newData.val() == 'STARTING' || newData.val() == 'PLAYING' || newData.val() == 'FINISHED' || newData.val() == 'CANCELLED'"
        },
        "diceRoll": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
        },
        "currentTurnIndex": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 4"
        },
        "turnNumber": {
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
